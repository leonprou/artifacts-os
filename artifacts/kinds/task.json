{
  "x-dir": "tasks",
  "x-prefix": "t",
  "x-numbered": true,
  "x-columns": ["id", "name", "status", "assignee"],
  "x-status-colors": {
    "backlog": "dim",
    "ready": "cyan",
    "in-progress": "yellow",
    "review": "blue",
    "verified": "magenta",
    "done": "green",
    "cancelled": "dim strike",
    "rejected": "red strike"
  },
  "title": "Task",
  "type": "object",
  "properties": {
    "status": {
      "enum": ["backlog", "ready", "in-progress", "review", "verified", "done", "cancelled", "rejected"]
    },
    "priority": {
      "type": "string",
      "description": "Optional priority hint (free-form, e.g. low, normal, high, urgent)"
    },
    "assignee": {
      "type": "string",
      "description": "Agent or person assigned to work on this task"
    },
    "owner": {
      "type": "string",
      "description": "Agent or person who owns/verifies this task"
    },
    "type": {
      "type": "string",
      "description": "Task type (e.g. implementation, documentation, feature, research)"
    }
  }
}
